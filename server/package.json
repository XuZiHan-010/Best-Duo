{
  "name": "@take-time/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "assess:levels": "tsx scripts/assessLevels.ts",
    "agentlab:provider-contract": "tsx scripts/runProviderContract.ts",
    "agentlab:m9.3": "tsx scripts/runM93Benchmark.ts",
    "dev": "npm run build -w @take-time/shared && tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@take-time/shared": "0.1.0",
    "express": "^4.19.2",
    "openai": "^6.47.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
